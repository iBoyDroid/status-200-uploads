              "type": "string"
            },
            {
              "id": "8e878fac-1acf-4c2e-bc82-862257141ca8",
              "name": "caption",
              "value": "Three quick tips for brighter photos with your phone #photography #tips",
              "type": "string"
            },
            {
              "id": "bb1633bf-0f08-4104-bae0-9d24330b98fd",
              "name": "youtube_title",
              "value": "Three quick tips for brighter phone photos #Shorts",
              "type": "string"
            },
            {
              "id": "e288cb2c-64d9-467c-a057-ef589583a871",
              "name": "check_only",
              "value": true,
              "type": "boolean"
            },
            {
              "id": "9447c895-c5c3-46d9-980e-7ce71d8eccaf",
              "name": "publish_at",
              "value": "",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
